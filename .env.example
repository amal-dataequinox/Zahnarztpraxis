# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string. For local development use the Docker Compose
# service: `docker compose up -d postgres`
DATABASE_URL=postgresql://palatty:palatty@127.0.0.1:5432/palatty

# ---------------------------------------------------------------------------
# Payload
# ---------------------------------------------------------------------------
# Secret used to sign JWTs and encrypt sensitive data. Generate a long random
# string for every environment. NEVER reuse the production secret elsewhere.
PAYLOAD_SECRET=change-me-generate-a-long-random-string

# ---------------------------------------------------------------------------
# Server / domains
# ---------------------------------------------------------------------------
# Public URL of THIS deployment (used as fallback for canonical URLs, admin
# live preview, etc.). In production this is one of the two public domains.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Domain -> location mapping. Comma-separated list of `hostname:location-slug`
# pairs. Hostnames must be lowercase, without protocol or port.
# Local development uses *.localhost subdomains which browsers resolve to
# 127.0.0.1 automatically (no /etc/hosts changes needed).
DOMAIN_LOCATION_MAP=zahnarztpraxis-palatty.ch:appenzell,www.zahnarztpraxis-palatty.ch:appenzell,zahnarzt-palatty.ch:gais,www.zahnarzt-palatty.ch:gais,appenzell.localhost:appenzell,gais.localhost:gais

# Location slug served when the hostname is unknown. Leave empty in production
# so unknown hosts receive a 404 instead of leaking the wrong location.
DEFAULT_LOCATION_SLUG=appenzell

# Internal /design-system showcase. Enabled automatically in development.
# Set to "true" to allow in production; "false" forces 404 even in development.
# DESIGN_SYSTEM_ENABLED=true

# ---------------------------------------------------------------------------
# Seed (development only)
# ---------------------------------------------------------------------------
# Credentials for the first super admin created by `pnpm seed`.
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# 3D hero (Distant Alpine silhouette)
# ---------------------------------------------------------------------------
# Set to "false" to force the static SVG fallback (no WebGL).
# Reduced-motion users always get the static fallback regardless.
NEXT_PUBLIC_ENABLE_ALPINE_3D=true

# ---------------------------------------------------------------------------
# Object Storage (S3 / Cloudflare R2) & CDN — Leave S3_BUCKET empty for local disk
# ---------------------------------------------------------------------------
# Required on Vercel / serverless deployments so uploads & media persist.
# For AWS S3 Zurich, set S3_REGION=eu-central-2. For Cloudflare R2, set S3_ENDPOINT.
S3_BUCKET=
S3_REGION=eu-central-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# CDN_URL=https://cdn.zahnarztpraxis-palatty.ch
